# Semua variabel bersifat opsional. Salin ke `.env` lalu sesuaikan bila perlu.

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Folder data (db.json, config.json, assets/). Default: ./.kreator-data
# KREATOR_DATA_DIR=/path/ke/data

# --- Web (dev) ---
# Tujuan proxy /api saat menjalankan Vite dev server.
# KREATOR_API_TARGET=http://127.0.0.1:8787

# --- Transkripsi lokal (opsional) ---
# Binary Whisper CLI bila ingin transkripsi offline.
# KREATOR_WHISPER_BIN=whisper
# KREATOR_WHISPER_MODEL=base
